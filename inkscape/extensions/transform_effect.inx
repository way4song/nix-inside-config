<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Modificar Caminho</name>
    <id>org.inkscape.effect.transform_copiar</id>
    
    <param name="copies" type="int" min="1" max="500" gui-text="Número de Cópias:">10</param>
    <param name="move_x" type="float" min="-1000" max="1000" gui-text="Mover X (px):">0.0</param>
    <param name="move_y" type="float" min="-1000" max="1000" gui-text="Mover Y (px):">0.0</param>
    <param name="scale" type="float" min="1" max="500" gui-text="Escala (%):">80.0</param>
    <param name="rotate" type="float" min="-360" max="360" gui-text="Rotação (graus):">45.0</param>

    <param name="anchor" type="optiongroup" appearance="combo" gui-text="Ponto de Ancoragem:">
        <option value="top-left">Superior Esquerdo</option>
        <option value="top-center">Superior Centro</option>
        <option value="top-right">Superior Direito</option>
        <option value="center-left">Centro Esquerdo</option>
        <option value="center" selected="true">Centro</option>
        <option value="center-right">Centro Direito</option>
        <option value="bottom-left">Inferior Esquerdo</option>
        <option value="bottom-center">Inferior Centro</option>
        <option value="bottom-right">Inferior Direito</option>
    </param>

    <param name="reflect_x" type="bool" gui-text="Refletir no Eixo X (Inverter Horiz.)">false</param>
    <param name="reflect_y" type="bool" gui-text="Refletir no Eixo Y (Inverter Vert.)">false</param>

    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Designer Livre"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">transform_effect.py</command>
    </script>
</inkscape-extension>